    {
      "name": "wait_for_update",
      "title": "Wait for project update",
      "description": "Poll get_project until the project status changes from the baseline observed at call start, or until the timeout budget is exhausted (max 300 seconds / 5 minutes). Sleeps max(retry_after, 2) seconds between polls. Returns the latest full state plus status_changed and waited_seconds. Chain calls for long-running executions.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project UUID."
          },
          "timeout_seconds": {
            "default": 180.0,
            "type": "number",
            "description": "Wait budget in seconds (clamped to ≤300; default 180)."
          }
        },
        "required": [
          "project_id"
        ],
        "type": "object"
      },
      "annotations": {
        "title": "Wait for project update",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      }
    }
