    {
      "name": "get_dataset",
      "title": "Get dataset rows",
      "description": "Get a dataset (optionally a specific version) with paginated rows. Default row_limit is 50 (max 2000) to protect agent context windows. The duplicated csv field is omitted unless include_csv=true. Use total_rows / row_offset / row_limit to paginate.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project UUID."
          },
          "dataset_id": {
            "type": "string",
            "description": "Dataset UUID."
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional version number (uses versions/{v} route when set)."
          },
          "row_offset": {
            "default": 0,
            "type": "integer",
            "description": "Row pagination offset (default 0)."
          },
          "row_limit": {
            "default": 50,
            "type": "integer",
            "description": "Row page size (clamped 1–2000, default 50)."
          },
          "include_csv": {
            "default": false,
            "type": "boolean",
            "description": "When True, keep the duplicated csv field."
          }
        },
        "required": [
          "project_id",
          "dataset_id"
        ],
        "type": "object"
      },
      "annotations": {
        "title": "Get dataset rows",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
