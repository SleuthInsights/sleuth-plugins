    {
      "name": "send_message",
      "title": "Send message or approval action",
      "description": "Send a user message or an action to a project. Provide exactly one of message (research question / clarification answer) or action (cancel, approve_plan, approve_schema, reject_plan, reject_schema). Approve/reject actions resume runs paused at awaiting_plan_approval / awaiting_schema_approval — these gates surface for user-owned keys and OAuth users whose Studio auto-approve settings are off (org keys auto-approve them). Optional feedback is only accepted with reject_plan / reject_schema. Returns a 202 acknowledgement. To attach files, call upload_document first, then send_message.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project UUID."
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "User message text (mutually exclusive with action)."
          },
          "action": {
            "anyOf": [
              {
                "enum": [
                  "cancel",
                  "approve_plan",
                  "approve_schema",
                  "reject_plan",
                  "reject_schema"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Control action (mutually exclusive with message): ``cancel``,\n``approve_plan``, ``approve_schema``, ``reject_plan``, or\n``reject_schema``."
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional rejection feedback, sent only when non-empty.\nOnly accepted alongside ``reject_plan`` / ``reject_schema``.\nEmpty string is treated as absent."
          }
        },
        "required": [
          "project_id"
        ],
        "type": "object"
      },
      "annotations": {
        "title": "Send message or approval action",
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "submit_onboarding_access_request",
