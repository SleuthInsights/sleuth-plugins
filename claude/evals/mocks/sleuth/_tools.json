    {
      "name": "get_project",
      "title": "Get project status",
      "description": "Get full project state — the primary polling endpoint. Status lifecycle: idle → processing → awaiting_plan_approval → awaiting_schema_approval → executing → complete / failed / cancelled. Org-scoped API keys auto-approve the plan/schema gates, so those agents typically see processing → executing → complete. User-owned keys and OAuth users honor their Studio auto-approve settings — resume gated runs via send_message actions. When status is awaiting_clarification, read the latest assistant message via get_messages and answer via send_message. Respect the retry_after hint (seconds) when polling.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project UUID."
          }
        },
        "required": [
          "project_id"
        ],
        "type": "object"
      },
      "annotations": {
        "title": "Get project status",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
