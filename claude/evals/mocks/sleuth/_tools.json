            "description": "User's confirmed country."
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Confirmed first name when not returned by status."
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Confirmed last name when not returned by status."
          },
          "company_website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Company website required for a work email."
          },
          "linkedin_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "LinkedIn profile required for a personal email."
          }
        },
        "required": [
          "company_name",
          "country"
        ],
        "type": "object"
      },
      "annotations": {
